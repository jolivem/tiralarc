{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "prisma:generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "prisma:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build", "prisma:generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "prisma:generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "prisma:generate"]
    },
    "test": {
      "dependsOn": ["^build", "prisma:generate"]
    },
    "test:e2e": {
      "dependsOn": ["^build", "prisma:generate"],
      "cache": false
    },
    "openapi": {
      "dependsOn": ["build"],
      "outputs": ["openapi.json"],
      "cache": false
    },
    "generate": {
      "outputs": ["src/schema.ts"],
      "cache": false
    },
    "@tiralarc/api-client#generate": {
      "dependsOn": ["@tiralarc/api#openapi"],
      "outputs": ["src/schema.ts"],
      "cache": false
    }
  }
}
