# Production settings, read by docker-compose.prod.yml and passed to the API.
# Copy to deploy/.env on the VPS (never commit it), then fill in every value.
# Generate secrets with: openssl rand -hex 32  (hex: safe inside URLs)

# Site domain (DNS A records for it and for s3.<domain> point to the VPS)
DOMAIN=tiralarc.example.com

# MariaDB (the API's DATABASE_URL is built from MARIADB_PASSWORD by the compose file)
MARIADB_ROOT_PASSWORD=change-me
MARIADB_PASSWORD=change-me

# JWT — at least 32 characters
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Public URL of the site (links in emails)
WEB_URL=https://tiralarc.example.com
# Public URL of the API, for the calendar subscription links (iCal). Leave unset: the API is served
# under the site's own URL (/api/*, see caddy/Caddyfile)
# API_PUBLIC_URL=
# Browser origins allowed by CORS: none needed (the site calls the API server-side, apps don't need CORS)
CORS_ORIGINS=

# Outgoing email: a real SMTP provider, e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=change-me
MAIL_FROM="MyArcheryDiary <no-reply@tiralarc.example.com>"
# Users' reviews of the app are sent here, with the link that publishes them on the home page
REVIEWS_EMAIL=feedback@myarcherydiary.com
# Alerted when a page of the FFTA website or ianseo.net is no longer read as expected (its layout changed)
ALERTS_EMAIL=feedback@myarcherydiary.com

# Sign in with Google / Apple — see docs/oauth-setup.md. Empty = disabled.
# The web's client IDs are baked into its image at build time (deploy/build.env on the dev machine).
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Photo storage: the Versity gateway of the compose file, reached through Caddy at s3.<domain>
# (browsers load photos from signed URLs). The keys are the gateway's root credentials.
S3_ENDPOINT=https://s3.tiralarc.example.com
S3_REGION=us-east-1
S3_BUCKET=tiralarc
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=true

# Small server (1 vCPU / 2 GB): the web prints PDF extracts one at a time, with a lighter
# Chromium. Empty = off.
VPS_WITH_2GB_RAM=true

LOG_LEVEL=info
