# Base URL of the NestJS API, reached server-side only (never exposed to the browser)
API_URL=http://localhost:3001

# Sign in with Google / Apple — see docs/oauth-setup.md. Leave empty to hide the buttons.
# Google: OAuth "Web application" client ID (must also be listed in the API's GOOGLE_CLIENT_IDS)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Apple: Services ID, and a return URL registered for it (HTTPS, not localhost)
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=
