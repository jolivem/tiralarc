NODE_ENV=test
PORT=3001

# MariaDB (see docker/docker-compose.yml — host port 3307)
DATABASE_URL="mysql://tiralarc:tiralarc@localhost:3307/tiralarc_test"
SHADOW_DATABASE_URL="mysql://tiralarc:tiralarc@localhost:3307/tiralarc_shadow"

# Comma-separated list of browser origins allowed by CORS (mobile apps don't need CORS)
CORS_ORIGINS="http://localhost:3000"
TRUST_PROXY=loopback

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

WEB_URL=http://localhost:3000
SMTP_URL=smtp://localhost:1025
GOOGLE_CLIENT_IDS=test-google-client
APPLE_CLIENT_IDS=test-apple-client
LOG_LEVEL=silent
