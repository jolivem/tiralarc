NODE_ENV=development
PORT=3001

# MariaDB (see docker/docker-compose.yml — host port 3307)
DATABASE_URL="mysql://tiralarc:tiralarc@localhost:3307/tiralarc"
SHADOW_DATABASE_URL="mysql://tiralarc:tiralarc@localhost:3307/tiralarc_shadow"

# Comma-separated list of browser origins allowed by CORS (mobile apps don't need CORS)
CORS_ORIGINS="http://localhost:3000"

# Hops allowed to set X-Forwarded-For (the Next.js server, a load balancer...)
TRUST_PROXY=loopback

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Public URL of the web app (links in emails)
WEB_URL=http://localhost:3000

# Outgoing email. Dev: Mailpit (docker), UI on http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Tiralarc <no-reply@tiralarc.local>"

# Sign in with Google / Apple — see docs/oauth-setup.md. Empty = disabled.
# Comma-separated client IDs accepted as token audience (web, Android, iOS).
GOOGLE_CLIENT_IDS=
# Services ID (web) and bundle ID (iOS).
APPLE_CLIENT_IDS=

# Photo storage (S3-compatible). Dev: local gateway started by `pnpm db:up`, on :9000.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tiralarc
S3_ACCESS_KEY=tiralarc
S3_SECRET_KEY=tiralarc-secret
S3_FORCE_PATH_STYLE=true

LOG_LEVEL=debug
