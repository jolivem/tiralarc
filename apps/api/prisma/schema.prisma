// Prisma schema — https://pris.ly/d/prisma-schema
// MariaDB is accessed through the `mysql` provider + @prisma/adapter-mariadb driver adapter.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  ARCHER
  COACH
}

enum AuthProvider {
  GOOGLE
  APPLE
}

model User {
  id              String    @id @default(uuid()) @db.Char(36)
  email           String    @unique @db.VarChar(255)
  /// Null for accounts created through Google / Apple only.
  passwordHash    String?   @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.DateTime(3)
  displayName     String?   @map("display_name") @db.VarChar(100)
  /// Preferred language (BCP 47, e.g. "fr", "en"), used for emails.
  locale          String    @default("fr") @db.VarChar(10)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  roles                   UserRole[]
  identities              UserIdentity[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  journals                Journal[]
  archerProfile           ArcherProfile?
  profileInvitations      ProfileInvitation[]
  favoriteSites           FavoriteSite[]
  sessionPhotos           SessionPhoto[]
  journalSessions         JournalSession[]

  @@map("users")
}

/// Roles are cumulative: a coach can also be an archer.
model UserRole {
  userId    String   @map("user_id") @db.Char(36)
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

/// External sign-in accounts (Google, Apple) linked to a user.
model UserIdentity {
  id        String       @id @default(uuid()) @db.Char(36)
  userId    String       @map("user_id") @db.Char(36)
  provider  AuthProvider
  /// Stable account id at the provider (the ID token's `sub` claim).
  subject   String       @db.VarChar(255)
  email     String?      @db.VarChar(255)
  createdAt DateTime     @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("user_identities")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// One row per issued refresh token. Tokens are rotated on every refresh:
/// the old row is revoked and points to its replacement, which lets us
/// detect reuse of a stolen token and revoke the whole family.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Char(36)
  userId       String    @map("user_id") @db.Char(36)
  familyId     String    @map("family_id") @db.Char(36)
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  deviceName   String?   @map("device_name") @db.VarChar(100)
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  expiresAt    DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt    DateTime? @map("revoked_at") @db.DateTime(3)
  replacedById String?   @map("replaced_by_id") @db.Char(36)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum SessionType {
  TRAINING
  COACHING
  COMPETITION
  STRENGTH
  /// Any other event: a date and a free text (`description`).
  OTHER
}

enum Discipline {
  INDOOR
  TAE_NATIONAL
  TAE_INTERNATIONAL
  THREE_D
  FIELD
  BEURSAULT
  RUN_ARCHERY
}

enum Feeling {
  GREAT
  OK
  BAD
  EXHAUSTED
}

/// An archer's journal: the sessions of one season (e.g. school year 2026-2027).
/// Both days are inclusive; an archer's journals may overlap.
model Journal {
  id          String   @id @default(uuid()) @db.Char(36)
  userId      String   @map("user_id") @db.Char(36)
  title       String   @db.VarChar(100)
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  /// Decoration around the calendar, month by month: { "2026-10": "<theme id>" }.
  /// Each client maps a theme id to its own artwork; a month without entry has no decoration.
  monthThemes Json?    @map("month_themes")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions JournalSession[]

  @@index([userId, startDate])
  @@map("journals")
}

/// A journal entry: a calendar event plus its session sheet (or a free text for `OTHER` events).
/// Date and time are "wall clock" values (no time zone): 18:00 stays 18:00 on every device.
model JournalSession {
  id              String      @id @default(uuid()) @db.Char(36)
  userId          String      @map("user_id") @db.Char(36)
  journalId       String      @map("journal_id") @db.Char(36)
  type            SessionType
  date            DateTime    @db.Date
  /// "HH:mm"; null = all-day event.
  startTime       String?     @map("start_time") @db.VarChar(5)
  durationMinutes Int?        @map("duration_minutes") @db.SmallInt
  location        String?     @db.VarChar(200)
  discipline      Discipline?
  distanceMeters  Int?        @map("distance_meters") @db.SmallInt
  arrowCount      Int?        @map("arrow_count") @db.SmallInt
  score           Int?        @db.SmallInt
  objective       String?     @db.Text
  /// Self-assessment, 0–10.
  satisfaction    Int?        @db.TinyInt
  technique       Int?        @db.TinyInt
  description     String?     @db.Text
  physicalFeeling Feeling?    @map("physical_feeling")
  mentalFeeling   Feeling?    @map("mental_feeling")
  /// Up to 3 short strings each.
  wentWell        Json        @map("went_well")
  toImprove       Json        @map("to_improve")
  nextTime        String?     @map("next_time") @db.Text
  /// `OTHER` events only: how the event shows in the calendar (see EVENT_COLORS / EVENT_ICONS).
  title           String?     @db.VarChar(100)
  color           String?     @db.VarChar(20)
  icon            String?     @db.VarChar(20)
  createdAt       DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  journal Journal        @relation(fields: [journalId], references: [id], onDelete: Cascade)
  photos  SessionPhoto[]

  @@index([userId, date])
  @@index([journalId, date])
  @@map("journal_sessions")
}

/// FFTA age categories.
enum AgeCategory {
  U11
  U13
  U15
  U18
  U21
  S1
  S2
  S3
}

enum BowType {
  RECURVE
  COMPOUND
  BAREBOW
  LONGBOW
  HUNTING
  FREE
}

/// An archer's sport details. Created on first save.
model ArcherProfile {
  userId        String       @id @map("user_id") @db.Char(36)
  licenceNumber String?      @map("licence_number") @db.VarChar(20)
  category      AgeCategory?
  bowType       BowType?     @map("bow_type")
  /// Array of `Discipline` values.
  disciplines   Json
  createdAt     DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("archer_profiles")
}

/// Someone an archer invited by email (e.g. their coach). Accepting gives no access yet.
model ProfileInvitation {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @map("user_id") @db.Char(36)
  name       String    @db.VarChar(100)
  email      String    @db.VarChar(255)
  isCoach    Boolean   @default(false) @map("is_coach")
  /// Hash of the token emailed to the guest.
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  /// Null while the invitation is pending.
  acceptedAt DateTime? @map("accepted_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@map("profile_invitations")
}

model FavoriteSite {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  label     String   @db.VarChar(100)
  url       String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("favorite_sites")
}

/// A photo attached to a journal event. The files (resized image + thumbnail) live in the
/// object storage, under `<userId>/<sessionId>/<id>`; the original upload is not kept.
model SessionPhoto {
  id        String   @id @default(uuid()) @db.Char(36)
  sessionId String   @map("session_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  width     Int      @db.SmallInt
  height    Int      @db.SmallInt
  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  session JournalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([userId])
  @@map("session_photos")
}
