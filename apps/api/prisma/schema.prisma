// Prisma schema — https://pris.ly/d/prisma-schema
// MariaDB is accessed through the `mysql` provider + @prisma/adapter-mariadb driver adapter.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  ARCHER
  COACH
}

enum AuthProvider {
  GOOGLE
  APPLE
}

model User {
  id              String    @id @default(uuid()) @db.Char(36)
  email           String    @unique @db.VarChar(255)
  /// Null for accounts created through Google / Apple only.
  passwordHash    String?   @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.DateTime(3)
  displayName     String?   @map("display_name") @db.VarChar(100)
  /// Preferred language (BCP 47, e.g. "fr", "en"), used for emails.
  locale          String    @default("fr") @db.VarChar(10)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  roles                   UserRole[]
  identities              UserIdentity[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  journalSessions         JournalSession[]

  @@map("users")
}

/// Roles are cumulative: a coach can also be an archer.
model UserRole {
  userId    String   @map("user_id") @db.Char(36)
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

/// External sign-in accounts (Google, Apple) linked to a user.
model UserIdentity {
  id        String       @id @default(uuid()) @db.Char(36)
  userId    String       @map("user_id") @db.Char(36)
  provider  AuthProvider
  /// Stable account id at the provider (the ID token's `sub` claim).
  subject   String       @db.VarChar(255)
  email     String?      @db.VarChar(255)
  createdAt DateTime     @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("user_identities")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// One row per issued refresh token. Tokens are rotated on every refresh:
/// the old row is revoked and points to its replacement, which lets us
/// detect reuse of a stolen token and revoke the whole family.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Char(36)
  userId       String    @map("user_id") @db.Char(36)
  familyId     String    @map("family_id") @db.Char(36)
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  deviceName   String?   @map("device_name") @db.VarChar(100)
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  expiresAt    DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt    DateTime? @map("revoked_at") @db.DateTime(3)
  replacedById String?   @map("replaced_by_id") @db.Char(36)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum SessionType {
  TRAINING
  COACHING
  COMPETITION
  STRENGTH
}

enum Discipline {
  INDOOR
  TAE_NATIONAL
  TAE_INTERNATIONAL
  THREE_D
  FIELD
}

enum Feeling {
  GREAT
  OK
  BAD
  EXHAUSTED
}

/// An archer's journal entry: a calendar event plus its session sheet.
/// Date and time are "wall clock" values (no time zone): 18:00 stays 18:00 on every device.
model JournalSession {
  id              String      @id @default(uuid()) @db.Char(36)
  userId          String      @map("user_id") @db.Char(36)
  type            SessionType
  date            DateTime    @db.Date
  /// "HH:mm"; null = all-day event.
  startTime       String?     @map("start_time") @db.VarChar(5)
  durationMinutes Int?        @map("duration_minutes") @db.SmallInt
  location        String?     @db.VarChar(200)
  discipline      Discipline?
  distanceMeters  Int?        @map("distance_meters") @db.SmallInt
  arrowCount      Int?        @map("arrow_count") @db.SmallInt
  score           Int?        @db.SmallInt
  objective       String?     @db.Text
  /// Self-assessment, 0–10.
  satisfaction    Int?        @db.TinyInt
  technique       Int?        @db.TinyInt
  description     String?     @db.Text
  physicalFeeling Feeling?    @map("physical_feeling")
  mentalFeeling   Feeling?    @map("mental_feeling")
  /// Up to 3 short strings each.
  wentWell        Json        @map("went_well")
  toImprove       Json        @map("to_improve")
  nextTime        String?     @map("next_time") @db.Text
  createdAt       DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("journal_sessions")
}
