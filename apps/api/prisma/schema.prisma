// Prisma schema — https://pris.ly/d/prisma-schema
// MariaDB is accessed through the `mysql` provider + @prisma/adapter-mariadb driver adapter.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  ARCHER
  COACH
}

enum AuthProvider {
  GOOGLE
  APPLE
}

model User {
  id              String    @id @default(uuid()) @db.Char(36)
  email           String    @unique @db.VarChar(255)
  /// Null for accounts created through Google / Apple only.
  passwordHash    String?   @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.DateTime(3)
  displayName     String?   @map("display_name") @db.VarChar(100)
  /// Preferred language (BCP 47, e.g. "fr", "en"), used for emails.
  locale          String    @default("fr") @db.VarChar(10)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  roles                   UserRole[]
  identities              UserIdentity[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  journals                Journal[]
  archerProfile           ArcherProfile?
  profileInvitations      ProfileInvitation[]
  invitationSends         InvitationSend[]
  /// The groups this user sorts the archers they coach into.
  coachGroups             CoachGroup[]
  /// The invitations this user accepted as someone's coach.
  coachedArchers          ProfileInvitation[]      @relation("CoachedArchers")
  favoriteSites           FavoriteSite[]
  dismissedCompetitions   DismissedCompetition[]
  /// What they thought of the app (one a day at most).
  appReviews              AppReview[]
  sessionPhotos           SessionPhoto[]
  goals                   Goal[]
  journalSessions         JournalSession[]
  /// Events this user planned in their archers' journals, as their coach.
  plannedSessions         JournalSession[]         @relation("PlannedSessions")
  customEventTypes        CustomEventType[]

  @@map("users")
}

/// Stored roles: ARCHER (every account, given at sign-up) and ADMIN (`user:make-admin`). COACH is
/// not stored: a user is a coach while a coach invitation they accepted exists (`rolesOf`).
model UserRole {
  userId    String   @map("user_id") @db.Char(36)
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

/// External sign-in accounts (Google, Apple) linked to a user.
model UserIdentity {
  id        String       @id @default(uuid()) @db.Char(36)
  userId    String       @map("user_id") @db.Char(36)
  provider  AuthProvider
  /// Stable account id at the provider (the ID token's `sub` claim).
  subject   String       @db.VarChar(255)
  email     String?      @db.VarChar(255)
  createdAt DateTime     @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("user_identities")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// "Forgot password": a single-use link emailed to the account's address (only its hash is kept).
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// One row per issued refresh token. Tokens are rotated on every refresh:
/// the old row is revoked and points to its replacement, which lets us
/// detect reuse of a stolen token and revoke the whole family.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Char(36)
  userId       String    @map("user_id") @db.Char(36)
  familyId     String    @map("family_id") @db.Char(36)
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  deviceName   String?   @map("device_name") @db.VarChar(100)
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  expiresAt    DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt    DateTime? @map("revoked_at") @db.DateTime(3)
  replacedById String?   @map("replaced_by_id") @db.Char(36)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum SessionType {
  TRAINING
  COACHING
  COMPETITION
  STRENGTH
  /// Any other event: a date and a free text (`description`).
  OTHER
  /// An event of one of the archer's own types (`customTypeId`): a date and a free text.
  CUSTOM
}

enum Discipline {
  INDOOR
  TAE_NATIONAL
  TAE_INTERNATIONAL
  THREE_D
  FIELD
  BEURSAULT
  RUN_ARCHERY
  NATURE
}

enum Feeling {
  GREAT
  OK
  BAD
  EXHAUSTED
}

/// The sky during an outdoor session.
enum Sky {
  SUNNY
  PARTLY_CLOUDY
  CLOUDY
  RAINY
}

/// The wind during an outdoor session.
enum Wind {
  CALM
  LIGHT
  MODERATE
  STRONG
}

/// An archer's journal: a named period, typically one season (e.g. school year 2026-2027).
/// Its events are the archer's sessions dated within the period (both days inclusive); there is no
/// link between the two tables. An archer's journals do not overlap (enforced by the API).
model Journal {
  id                 String   @id @default(uuid()) @db.Char(36)
  userId             String   @map("user_id") @db.Char(36)
  title              String   @db.VarChar(100)
  startDate          DateTime @map("start_date") @db.Date
  endDate            DateTime @map("end_date") @db.Date
  /// Decoration around the calendar, month by month: { "2026-10": "<theme id>" }.
  /// Each client maps a theme id to its own artwork; a month without entry has no decoration.
  monthThemes        Json?    @map("month_themes")
  /// The archer's overall satisfaction with each month, in stars (0.5 to 5, by halves):
  /// { "2026-10": 3.5 }; a month without entry is not rated.
  monthSatisfactions Json?    @map("month_satisfactions")
  /// The journal clients open at sign-in. One per archer at most (kept by the API, not the database).
  isDefault          Boolean  @default(false) @map("is_default")
  createdAt          DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
  @@map("journals")
}

/// An archer's event: a calendar entry plus its session sheet (or a free text for `OTHER` events).
/// It shows in the journal whose period covers its date, if any.
/// An event is a day's entry, without a time; its date is a calendar day (no time zone).
model JournalSession {
  id                  String      @id @default(uuid()) @db.Char(36)
  userId              String      @map("user_id") @db.Char(36)
  type                SessionType
  date                DateTime    @db.Date
  durationMinutes     Int?        @map("duration_minutes") @db.SmallInt
  location            String?     @db.VarChar(200)
  discipline          Discipline?
  distanceMeters      Int?        @map("distance_meters") @db.SmallInt
  arrowCount          Int?        @map("arrow_count") @db.SmallInt
  score               Int?        @db.SmallInt
  objective           String?     @db.Text
  /// Trainings and coachings: the session's steps ("Déroulé de la séance"), planned ahead.
  /// JSON array of { unit: MINUTES | ARROWS, amount, target: STRAW | VISUAL | FACE, description,
  /// done } (`done`: ticked once the day has come; absent in older rows = false).
  steps               Json?
  /// Outdoor sessions: the weather, noted with the review (not part of `completed`).
  sky                 Sky?
  wind                Wind?
  temperatureC        Int?        @map("temperature_c") @db.TinyInt
  /// Self-assessment, 0–10.
  satisfaction        Int?        @db.TinyInt
  technique           Int?        @db.TinyInt
  description         String?     @db.Text
  physicalFeeling     Feeling?    @map("physical_feeling")
  mentalFeeling       Feeling?    @map("mental_feeling")
  /// Up to 3 short strings each.
  wentWell            Json        @map("went_well")
  toImprove           Json        @map("to_improve")
  nextTime            String?     @map("next_time") @db.Text
  /// `OTHER` events only: how the event shows in the calendar (see EVENT_COLORS / EVENT_ICONS).
  title               String?     @db.VarChar(100)
  color               String?     @db.VarChar(20)
  icon                String?     @db.VarChar(20)
  /// `CUSTOM` events only: their type (title, colour and pictogram come from it).
  customTypeId        String?     @map("custom_type_id") @db.Char(36)
  /// The coach who planned the event (null = the archer). They may change or delete it while it
  /// is still to come; the archer always can.
  plannedById         String?     @map("planned_by_id") @db.Char(36)
  /// When the archer first opened the sheet of an event their coach planned; null = new to them.
  seenAt              DateTime?   @map("seen_at") @db.DateTime(3)
  /// The FFTA competition it was added from (https://www.ffta.fr/epreuve/{id}); at most
  /// `MAX_PER_COMPETITION_DAY` such events per competition and day.
  fftaCompetitionId   String?     @map("ffta_competition_id") @db.VarChar(20)
  /// The last day its score sheet was looked for on ianseo.net (see `ScoreSheet`).
  scoreSheetCheckedOn DateTime?   @map("score_sheet_checked_on") @db.Date
  createdAt           DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  customType CustomEventType? @relation(fields: [customTypeId], references: [id], onDelete: SetNull)
  plannedBy  User?            @relation("PlannedSessions", fields: [plannedById], references: [id], onDelete: SetNull)
  photos     SessionPhoto[]
  scoreSheet ScoreSheet?

  @@index([userId, date])
  @@index([customTypeId])
  @@index([plannedById])
  @@map("journal_sessions")
}

/// The archer's score sheet at a competition: their page(s) of the PDFs published on ianseo.net.
model ScoreSheet {
  sessionId String   @id @map("session_id") @db.Char(36)
  pdf       Bytes    @db.MediumBlob
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  session JournalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("score_sheets")
}

/// An event type the archer defined (a few at most, see MAX_CUSTOM_TYPES). Deleting one turns its
/// events into `OTHER` events with the same title, colour and pictogram (done by the API).
model CustomEventType {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  title     String   @db.VarChar(40)
  /// See EVENT_COLORS / EVENT_ICONS.
  color     String   @db.VarChar(20)
  icon      String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions JournalSession[]

  @@index([userId])
  @@map("custom_event_types")
}

/// FFTA age categories.
enum AgeCategory {
  U11
  U13
  U15
  U18
  U21
  S1
  S2
  S3
}

enum BowType {
  RECURVE
  COMPOUND
  BAREBOW
  LONGBOW
  HUNTING
  FREE
}

/// An FFTA competition the archer will not take part in: left out of the home page's competitions
/// to plan (the calendars still show it).
enum ReviewStatus {
  PENDING
  PUBLISHED
  REFUSED
}

/// A user's review of the app: stars and a comment, sent to REVIEWS_EMAIL with a link to
/// publish or refuse it (`moderationTokenHash`: SHA-256 of the link's token, used once);
/// published ones show on the visitors' home page under the author's first name.
model AppReview {
  id                  String       @id @default(uuid()) @db.Char(36)
  userId              String       @map("user_id") @db.Char(36)
  /// 1 to 5.
  stars               Int          @db.TinyInt
  comment             String       @db.Text
  /// As shown: the first name and the initial of the last ("Camille D."), taken when written.
  authorName          String       @map("author_name") @db.VarChar(100)
  status              ReviewStatus @default(PENDING)
  moderationTokenHash String       @unique @map("moderation_token_hash") @db.Char(64)
  createdAt           DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  decidedAt           DateTime?    @map("decided_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, decidedAt])
  @@map("app_reviews")
}

/// A French town's coordinates, as api-adresse.data.gouv.fr gave them (GeocoderService): towns
/// of the FFTA competitions and archers' home towns, looked up once. `key`: department code (or
/// none) and the town's name, normalised. No coordinates: the town was not found.
model GeocodedPlace {
  key       String   @id @db.VarChar(160)
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@map("geocoded_places")
}

model DismissedCompetition {
  userId            String   @map("user_id") @db.Char(36)
  /// https://www.ffta.fr/epreuve/{id}
  fftaCompetitionId String   @map("ffta_competition_id") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, fftaCompetitionId])
  @@map("dismissed_competitions")
}

/// An archer's sport details. Created on first save.
model ArcherProfile {
  userId            String       @id @map("user_id") @db.Char(36)
  licenceNumber     String?      @map("licence_number") @db.VarChar(20)
  /// As on the licence: with it, they find the score sheets on ianseo.net.
  lastName          String?      @map("last_name") @db.VarChar(60)
  firstName         String?      @map("first_name") @db.VarChar(60)
  category          AgeCategory?
  bowType           BowType?     @map("bow_type")
  /// Array of `Discipline` values.
  disciplines       Json
  /// Font id of the calendars' days (each client maps it to its own font); null = the client's default.
  calendarFont      String?      @map("calendar_font") @db.VarChar(30)
  /// The indicator shown on the home page; null = none.
  favoriteIndicator Indicator?   @map("favorite_indicator")
  /// Whether the archer practises in France (asked when creating a journal); null = not answered.
  practisesInFrance Boolean?     @map("practises_in_france")
  /// Code of the department where the archer is licensed (only when practising in France);
  /// always among `departments`, which can't lose it.
  licenceDepartment String?      @map("licence_department") @db.VarChar(3)
  /// Array of French department codes ("78", "2A", "971"…, at most 5) whose FFTA competitions
  /// the calendars show; empty = none shown.
  departments       Json
  /// Also show the para-archery competitions (indoor and outdoor) of the departments.
  paraCompetitions  Boolean      @default(false) @map("para_competitions")
  /// Where the archer sets off from (their club's or home town): the competitions map measures
  /// the distance to travel from it. Its coordinates are looked up when it is saved (null: not
  /// found, or none).
  homeTown          String?      @map("home_town") @db.VarChar(100)
  homeLatitude      Float?       @map("home_latitude")
  homeLongitude     Float?       @map("home_longitude")
  createdAt         DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("archer_profiles")
}

/// The indicators an archer can pick as favourite (the goals are not one of them).
enum Indicator {
  ARROWS
  DURATIONS
  SCORES
  EVENTS
  COMPETITIONS
  PHYSICAL_FEELINGS
  MENTAL_FEELINGS
  /// Average per arrow, by distance (score / arrows of the scored sessions).
  ARROW_AVERAGES
}

/// What an archer's coach may do in the journal of the season in progress.
enum CoachAccess {
  /// See everything in it (calendar, sheets, photos), plus the indicators and goals.
  READ
  /// READ, and plan future trainings, coachings, competitions and strength sessions.
  WRITE
}

/// Someone an archer invited by email. A plain guest is only invited to discover the site; a
/// coach (`isCoach`) who accepts while signed in is linked (`coachId`) and gets `coachAccess` to
/// the archer's journal of the season in progress (the one whose period covers today).
model ProfileInvitation {
  id           String       @id @default(uuid()) @db.Char(36)
  userId       String       @map("user_id") @db.Char(36)
  name         String       @db.VarChar(100)
  email        String       @db.VarChar(255)
  isCoach      Boolean      @default(false) @map("is_coach")
  /// Coaches only.
  coachAccess  CoachAccess? @map("coach_access")
  /// The account that accepted a coach invitation (whatever its email: the link is the proof).
  coachId      String?      @map("coach_id") @db.Char(36)
  /// The coach's own group for this archer; null = in none. The archer doesn't see it.
  coachGroupId String?      @map("coach_group_id") @db.Char(36)
  /// Hash of the token emailed to the guest.
  tokenHash    String       @unique @map("token_hash") @db.Char(64)
  /// Null while the invitation is pending.
  acceptedAt   DateTime?    @map("accepted_at") @db.DateTime(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.DateTime(3)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  coach      User?       @relation("CoachedArchers", fields: [coachId], references: [id], onDelete: Cascade)
  coachGroup CoachGroup? @relation(fields: [coachGroupId], references: [id], onDelete: SetNull)

  @@unique([userId, email])
  @@unique([userId, coachId])
  @@index([coachId])
  @@index([coachGroupId])
  @@map("profile_invitations")
}

/// A named group of the archers a coach follows. Deleting it leaves its archers in none.
model CoachGroup {
  id        String   @id @default(uuid()) @db.Char(36)
  coachId   String   @map("coach_id") @db.Char(36)
  name      String   @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  coach   User                @relation(fields: [coachId], references: [id], onDelete: Cascade)
  archers ProfileInvitation[]

  @@unique([coachId, name])
  @@map("coach_groups")
}

/// One per invitation sent in the last 24 hours (the daily quota): unlike `ProfileInvitation`,
/// it stays when the invitation is removed.
model InvitationSend {
  id     String   @id @default(uuid()) @db.Char(36)
  userId String   @map("user_id") @db.Char(36)
  sentAt DateTime @default(now()) @map("sent_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@map("invitation_sends")
}

model FavoriteSite {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  label     String   @db.VarChar(100)
  url       String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("favorite_sites")
}

/// A photo attached to a journal event. The files (resized image + thumbnail) live in the
/// object storage, under `<userId>/<sessionId>/<id>`; the original upload is not kept.
model SessionPhoto {
  id        String   @id @default(uuid()) @db.Char(36)
  sessionId String   @map("session_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  width     Int      @db.SmallInt
  height    Int      @db.SmallInt
  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  session JournalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([userId])
  @@map("session_photos")
}

enum GoalType {
  SPORT
  TECHNIQUE
  PHYSICAL
  PERSONAL
}

/// A goal an archer sets for themselves. Reached once `achievedOn` is set.
model Goal {
  id          String    @id @default(uuid()) @db.Char(36)
  userId      String    @map("user_id") @db.Char(36)
  type        GoalType
  description String    @db.VarChar(500)
  /// Day the archer set the goal (they can backdate it), not the row's timestamp.
  createdOn   DateTime  @map("created_on") @db.Date
  /// Day the goal was reached; null = not yet.
  achievedOn  DateTime? @map("achieved_on") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdOn])
  @@map("goals")
}
