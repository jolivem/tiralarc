            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SocialSignInDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPairDto"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_ID_TOKEN"
          },
          "409": {
            "description": "EMAIL_TAKEN (email not verified by the provider)"
          }
        },
        "summary": "Sign in / sign up with a Google ID token",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/apple": {
      "post": {
        "operationId": "Auth_apple",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SocialSignInDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPairDto"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_ID_TOKEN"
          },
          "409": {
            "description": "EMAIL_TAKEN (email not verified by the provider)"
          }
        },
        "summary": "Sign in / sign up with a Sign in with Apple identity token",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "Auth_refresh",
