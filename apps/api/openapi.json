              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationDto"
                }
              }
            }
          },
          "409": {
            "description": "EMAIL_TAKEN"
          }
        },
        "summary": "Sign up with email + password; a confirmation link is emailed",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/verify-email": {
