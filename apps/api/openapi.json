        ]
      }
    },
    "/api/v1/users/me/roles": {
      "put": {
        "operationId": "Users_updateMyRoles",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMyRolesDto"
              }
            }
          }
        },
        "responses": {
          "200": {
