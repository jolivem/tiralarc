  },
  "info": {
    "title": "Tiralarc API",
    "description": "Public API consumed by the web app and the mobile apps.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "SelfAssignableRole": {
        "type": "string",
        "enum": [
          "ARCHER",
          "COACH"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "jane@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "displayName": {
            "type": "string",
            "maxLength": 100
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/SelfAssignableRole"
            }
          },
          "locale": {
            "type": "string",
            "enum": [
              "fr",
              "en"
            ],
            "description": "Language of the emails sent to the user."
          }
        },
        "required": [
          "email",
          "password",
          "roles"
        ]
      },
      "RegistrationDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "verificationRequired": {
            "type": "boolean",
            "description": "Always true: a confirmation link was emailed; login is refused until it is used."
          }
        },
        "required": [
          "email",
          "verificationRequired"
        ]
      },
      "VerifyEmailDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Token from the link emailed at registration."
          },
          "deviceName": {
            "type": "string",
            "description": "Human-readable device label (e.g. \"Pixel 9\", \"Firefox on Linux\"), shown in session lists.",
            "maxLength": 100
          }
        },
        "required": [
          "token"
        ]
      },
      "TokenPairDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Short-lived JWT, sent as `Authorization: Bearer <token>`."
          },
          "refreshToken": {
            "type": "string",
            "description": "Opaque, single-use token exchanged at /auth/refresh for a new pair."
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "number",
            "description": "Access token lifetime, in seconds."
          },
          "refreshExpiresIn": {
            "type": "number",
            "description": "Refresh token lifetime, in seconds."
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "tokenType",
          "expiresIn",
          "refreshExpiresIn"
        ]
      },
      "ResendVerificationDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "jane@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "deviceName": {
            "type": "string",
            "description": "Human-readable device label (e.g. \"Pixel 9\", \"Firefox on Linux\"), shown in session lists.",
            "maxLength": 100
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SocialSignInDto": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "description": "ID token returned by Google Identity Services / Sign in with Apple (web or native SDK)."
          },
          "nonce": {
            "type": "string",
            "description": "Nonce passed to the provider when requesting the token; checked if present."
          },
          "roles": {
            "type": "array",
            "description": "Roles for a new account. If omitted for a new account, it is created without roles and the client must ask the user (PUT /users/me/roles). Ignored for existing accounts.",
            "items": {
              "$ref": "#/components/schemas/SelfAssignableRole"
            }
          },
          "displayName": {
            "type": "string",
            "maxLength": 100,
            "description": "Apple only sends the name to the client, on first sign-in: forward it here."
          },
          "locale": {
            "type": "string",
            "enum": [
              "fr",
              "en"
            ]
          },
          "deviceName": {
            "type": "string",
            "description": "Human-readable device label (e.g. \"Pixel 9\", \"Firefox on Linux\"), shown in session lists.",
            "maxLength": 100
          }
        },
        "required": [
          "idToken"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "ADMIN",
          "ARCHER",
          "COACH"
        ],
        "description": "Empty for an account created through Google / Apple whose user has not chosen yet."
      },
      "AuthProvider": {
        "type": "string",
        "enum": [
          "GOOGLE",
          "APPLE"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "locale": {
            "type": "string",
            "example": "fr"
          },
          "roles": {
            "type": "array",
            "description": "Empty for an account created through Google / Apple whose user has not chosen yet.",
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          },
          "hasPassword": {
            "type": "boolean",
            "description": "False for accounts created through Google / Apple only."
          },
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuthProvider"
            }
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "emailVerified",
          "displayName",
          "locale",
          "roles",
          "hasPassword",
          "providers",
          "createdAt"
        ]
      },
      "UpdateMyRolesDto": {
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "minItems": 1,
            "description": "Replaces the self-assignable roles (ADMIN, if held, is kept).",
            "items": {
              "$ref": "#/components/schemas/SelfAssignableRole"
            }
          }
        },
        "required": [
          "roles"
        ]
      }
    }
  }
}
