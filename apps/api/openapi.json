    "/api/v1/users": {
      "get": {
        "operationId": "Users_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserDto"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Admins only"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
