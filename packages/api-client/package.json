{
  "name": "@tiralarc/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "openapi-typescript ../../apps/api/openapi.json -o src/schema.ts",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@tiralarc/eslint-config": "workspace:*",
    "@tiralarc/tsconfig": "workspace:*",
    "eslint": "^10.12.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3"
  }
}
